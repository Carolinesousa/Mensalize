# Docker Compose — copie para .env e ajuste antes de subir a stack.
# Gere a APP_KEY com: docker compose run --rm api php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost
APP_PORT=80

# Banco de dados (serviço mysql do compose).
DB_DATABASE=mensalize
DB_USERNAME=mensalize
DB_PASSWORD=secret
MYSQL_ROOT_PASSWORD=secret

# Sanctum SPA: SPA e API no mesmo domínio (ADR 0016).
# Em produção com HTTPS: SANCTUM_STATEFUL_DOMAINS=seu-dominio
#                          SESSION_DOMAIN=.seu-dominio
#                          SESSION_SECURE_COOKIE=true
#                          APP_URL=https://seu-dominio
SANCTUM_STATEFUL_DOMAINS=localhost
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
